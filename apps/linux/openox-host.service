[Unit]
Description=OpenOx Linux Host (loopback only)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/openox
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun apps/linux/src/main.ts serve --listen 127.0.0.1 --port 9876
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
Nice=5
MemoryMax=4G
NoNewPrivileges=yes

[Install]
WantedBy=default.target
